index 8ab0ca2..113fe4e 100644
--- a/tests/test_builddriver.py
+++ b/tests/test_builddriver.py
@@ -241,3 +241,45 @@ class WorldNameTests(unittest.TestCase):
                 (maps / f'{name}.d3dbsp.gfx.bin').write_bytes(b'')
             with self.assertRaisesRegex(RuntimeError, 'several map worlds'):
                 builddriver.world_name(Path(tmp), 'mod')
+
+
+class ShaderCheckReuseTests(unittest.TestCase):
+    """WAW2BO2_FAST_LINK step 6 reuses build-mod's dump only for the same bytes."""
+
+    def _mod(self, root):
+        import time
+        mod = root / 'mod_build'
+        (mod / 'shader_out').mkdir(parents=True)
+        (mod / 'out').mkdir()
+        (mod / 'shader_check/materials').mkdir(parents=True)
+        (mod / 'shader_out/mod.ff').write_bytes(b'linked zone')
+        (mod / 'out/mod.ff').write_bytes(b'linked zone')
+        (mod / 'shader_activation.json').write_text(json.dumps({'output': str(mod / 'out/mod.ff')}))
+        later = time.time() + 5
+        (mod / 'shader_check.log').write_text('')
+        os.utime(mod / 'shader_check.log', (later, later))
+        return mod
+
+    def test_reuses_dump_of_identical_zone(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            mod = self._mod(Path(tmp))
+            self.assertEqual(builddriver.shader_check_dump(mod, mod / 'out/mod.ff'), mod / 'shader_check')
+
+    def test_changed_zone_is_dumped_again(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            mod = self._mod(Path(tmp))
+            (mod / 'out/mod.ff').write_bytes(b'linker zone')   # same size, other bytes
+            self.assertIsNone(builddriver.shader_check_dump(mod, mod / 'out/mod.ff'))
+
+    def test_no_shader_activation_or_other_zone(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            mod = self._mod(Path(tmp))
+            self.assertIsNone(builddriver.shader_check_dump(mod, Path(tmp) / 'zm_map.ff'))
+            (mod / 'shader_activation.json').unlink()
+            self.assertIsNone(builddriver.shader_check_dump(mod, mod / 'out/mod.ff'))
+
+    def test_stale_check_is_not_reused(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            mod = self._mod(Path(tmp))
+            os.utime(mod / 'shader_check.log', (1, 1))
+            self.assertIsNone(builddriver.shader_check_dump(mod, mod / 'out/mod.ff'))
