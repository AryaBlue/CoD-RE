+def _sha256(path: Path) -> str:
+    import hashlib
+    digest = hashlib.sha256()
+    with path.open('rb') as stream:
+        for block in iter(lambda: stream.read(1 << 20), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def shader_check_dump(mod: Path, ff: Path) -> Path | None:
+    """build-mod's material,techniqueset dump of the final mod.ff, when it is
+    provably a dump of ``ff`` itself: activate_mod_shaders unlinked
+    shader_out/mod.ff and copied those bytes to ``ff``. Anything else (no shader
+    activation, an older dump, a different file) returns None."""
+    if ff.resolve() != (mod / 'out/mod.ff').resolve():
+        return None
+    check, linked = mod / 'shader_check', mod / 'shader_out/mod.ff'
+    try:
+        meta = json.loads((mod / 'shader_activation.json').read_text(encoding='utf-8'))
+        if Path(meta['output']).resolve() != ff.resolve() or not (check / 'materials').is_dir():
+            return None
+        if linked.stat().st_size != ff.stat().st_size or _sha256(linked) != _sha256(ff):
+            return None
+        if (mod / 'shader_check.log').stat().st_mtime < linked.stat().st_mtime:
+            return None
+    except (OSError, ValueError, KeyError):
+        return None
+    return check
+
