+            dirs.append(d * 4.0 - 2.0)
+            bright = raw / 65535.0 * T5_BRIGHTNESS
+            colour = (4.0 * red * bright, 2.0 * max(0.0, 1.0 - red - blue) * bright, 4.0 * blue * bright)
+            if half == 0:
